{
  "name": "reading-tracker-backend",
  "type": "module",
  "imports": {
    "#src/*": "./src/*",
    "#prisma/*": "./prisma/*",
    "#generated/*": "./generated/*"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:pull": "prisma db pull",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cors": "^2.8.6",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "dotenv": "^18.0.8",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "prisma": "^7.10.0",
    "typescript": "^7.0.2"
  }
}
