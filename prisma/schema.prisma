// Prisma schema — Reading Tracker (ứng dụng 1 người dùng, không có bảng User)
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"

  // Dự án dùng ESM ("type": "module" trong package.json).
  // Generator prisma-client chỉ sinh được .ts/.mts/.cts, nên client là .ts ESM
  // và được Node >= 22.18 chạy trực tiếp nhờ type stripping (không cần build).
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "mysql"
  // url được nạp từ biến môi trường DATABASE_URL trong prisma7.config.ts
}

/// Trạng thái đọc — khớp ENUM('want','reading','read') của cột `status`.
/// Thứ tự khai báo giữ nguyên để MySQL sinh ENUM đúng thứ tự.
enum ShelfStatus {
  want
  reading
  read
}

/// Một cuốn sách trên giá — bảng `shelf_books`
model ShelfBook {
  id Int @id @default(autoincrement())

  key String @unique @db.VarChar(32)

  title       String  @db.VarChar(255)
  author_name String? @db.VarChar(500)

  cover_i Int?

  first_publish_year Int? @db.SmallInt
  total_pages        Int?

  status       ShelfStatus @default(want)
  current_page Int         @default(0)

  /// 1..5 sao. CHECK 1..5 nằm trong migration.sql (Prisma không khai báo được CHECK).
  rating Int? @db.TinyInt

  note String? @db.VarChar(500)

  started_at  DateTime?
  finished_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@map("shelf_books")
}